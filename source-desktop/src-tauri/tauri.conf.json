{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Source",
  "version": "0.1.0",
  "identifier": "dev.source.ide",
  "build": {
    "beforeDevCommand": "pnpm --filter source-desktop dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm --filter source-desktop build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Source",
        "width": 1200,
        "height": 800,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.png"
    ]
  },
  "plugins": {}
}
